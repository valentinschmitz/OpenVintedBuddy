{
  "manifest_version": 3,
  "name": "OpenVintedBuddy",
  "version": "0.1.0",
  "description": "Votre assistant de gestion de dressing local.",
  "action": {
    "default_title": "OpenVintedBuddy",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8787/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}