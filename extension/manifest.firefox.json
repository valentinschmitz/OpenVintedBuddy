{
  "manifest_version": 3,
  "name": "OpenVintedBuddy",
  "version": "0.1.0",
  "description": "Votre assistant de gestion de dressing local.",
  "action": {
    "default_title": "OpenVintedBuddy",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8787/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "openvintedbuddy@local"
    }
  }
}